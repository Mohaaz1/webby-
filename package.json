{
  "name": "smartshop-ecommerce",
  "version": "1.0.0",
  "description": "SmartShop - MEVN Ecommerce Platform with Multi-Payment Integration",
  "type": "module",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch api/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node api/index.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "nodemailer": "^6.9.6",
    "paypal-rest-sdk": "^1.7.1",
    "pinia": "^3.0.4",
    "stripe": "^13.9.0",
    "vite": "^8.0.14",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  },
  "engines": {
    "node": "18.x"
  }
}
